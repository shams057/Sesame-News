# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Time zone used to group statistics by day and to define "today".
APP_TIMEZONE=Africa/Tunis
# Comma-separated list of origins allowed to call the API (admin web, user web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Absolute or relative (to Backend/) folder for uploaded files.
UPLOAD_DIR=uploads

# ─── Database (MySQL 8) ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sesame_news
DB_USER=root
DB_PASSWORD=
# Used only by `npm test` (the database is wiped by the test run).
DB_NAME_TEST=sesame_news_test

# ─── Authentication ────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h

# ─── AI assistant (any OpenAI-compatible API) ──────────────────────────────
# Leave the placeholders to keep the assistant disabled (the app then says it
# is not configured). Replace them to enable it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=YOUR_MODEL_NAME
LLM_API_KEY=YOUR_API_KEY

# ─── Push notifications (Expo) ─────────────────────────────────────────────
# Optional: only needed if "Enhanced security for push notifications" is on.
EXPO_ACCESS_TOKEN=

# ─── First super admin (used by `npm run db:seed` only if both are set) ────
SEED_ADMIN_LOGIN=
SEED_ADMIN_PASSWORD=
