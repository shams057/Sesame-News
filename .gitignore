# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12
*.keystore
!debug.keystore

# User-generated content (never commit uploads)
Backend/uploads/*
!Backend/uploads/.gitkeep

# Local-only files (old dumps, notes, personal data)
.local/

# Build output
dist/
build/
coverage/
web-build/

# Logs
*.log
logs/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Firebase service-account keys (never commit)
*firebase-adminsdk*.json
service-account*.json

# Local tooling
.claude/

# Built app packages (attach to a GitHub release instead of committing)
releases/
*.apk
*.aab
