# Backend base URL (no trailing slash). Copy to `.env.local`.
# Physical phone over USB: keep localhost and run `adb reverse tcp:3000 tcp:3000`.
# Phone on Wi-Fi: use your computer's LAN IP, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
# Expo project id (from `npx eas-cli init`), needed for push notifications.
EAS_PROJECT_ID=6e05092b-8e3b-433c-bf40-d2306a38ccc2
